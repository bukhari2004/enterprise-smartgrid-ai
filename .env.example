APP_ENV=dev                      # dev enables demo API keys; use prod + API_KEYS in production
API_KEYS=                        # e.g. "s3cr3t-a:admin,s3cr3t-b:operator,s3cr3t-c:viewer"
SMARTGRID_SCALE=demo             # tiny | demo | large
DATABASE_URL=sqlite:///data/smartgrid.db   # postgresql://grid:grid@postgres:5432/grid
REDIS_URL=                       # redis://redis:6379/0
KAFKA_BOOTSTRAP=                 # kafka:9092
KAFKA_TOPIC=grid.events
NEO4J_URI=                       # bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
ANTHROPIC_API_KEY=               # optional: LLM rewrites the copilot's grounded answer
LLM_MODEL=claude-sonnet-5-5
